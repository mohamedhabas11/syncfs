# SyncFS daemon production image (VM test fleet).
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/syncfs ./cmd/syncfs

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
RUN addgroup -S syncfs && adduser -S syncfs -G syncfs
COPY --from=build /out/syncfs /usr/bin/syncfs
USER syncfs
ENTRYPOINT ["/usr/bin/syncfs", "daemon", "--config", "/etc/syncfs/node.json"]
